      "short_name": "Live TV",
      "description": "Browse channels and schedules",
      "url": "./live-tv.html",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Discover",
      "short_name": "Discover",
      "description": "Search movies and TV series",
      "url": "./discover.html",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "My Library",
      "short_name": "Library",
      "description": "Open your saved media",
      "url": "./index.html#library",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
